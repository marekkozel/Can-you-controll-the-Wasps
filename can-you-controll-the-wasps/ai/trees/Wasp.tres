[gd_resource type="BehaviorTree" format=3 uid="uid://duqipvlyjy31h"]

[ext_resource type="Script" uid="uid://dnrhqurjlsmn6" path="res://ai/tasks/Defend.gd" id="1_defend"]
[ext_resource type="Script" uid="uid://jumrv5jg8n1e" path="res://ai/tasks/HasCargo.gd" id="2_hascargo"]
[ext_resource type="Script" uid="uid://0na0nqh4h573" path="res://ai/tasks/Deliver.gd" id="3_deliver"]
[ext_resource type="Script" uid="uid://sxqadvapt0mh" path="res://ai/tasks/IsGathering.gd" id="4_isgathering"]
[ext_resource type="Script" uid="uid://bvh1l4dvi0yhc" path="res://ai/tasks/Gather.gd" id="5_gather"]
[ext_resource type="Script" uid="uid://mqfqoxa3sb0o" path="res://ai/tasks/Idle.gd" id="6_idle"]

[sub_resource type="BlackboardPlan" id="BlackboardPlan_wasp"]

[sub_resource type="BTAction" id="BTAction_defend"]
script = ExtResource("1_defend")

[sub_resource type="BTSequence" id="BTSequence_defend"]
custom_name = "Seq - Defend"
children = [SubResource("BTAction_defend")]

[sub_resource type="BTCondition" id="BTCondition_hascargo"]
script = ExtResource("2_hascargo")

[sub_resource type="BTAction" id="BTAction_deliver"]
script = ExtResource("3_deliver")

[sub_resource type="BTSequence" id="BTSequence_deliver"]
custom_name = "Seq - Deliver"
children = [SubResource("BTCondition_hascargo"), SubResource("BTAction_deliver")]

[sub_resource type="BTCondition" id="BTCondition_isgathering"]
script = ExtResource("4_isgathering")

[sub_resource type="BTAction" id="BTAction_gather"]
script = ExtResource("5_gather")

[sub_resource type="BTSequence" id="BTSequence_gather"]
custom_name = "Seq - Gather"
children = [SubResource("BTCondition_isgathering"), SubResource("BTAction_gather")]

[sub_resource type="BTAction" id="BTAction_idle"]
script = ExtResource("6_idle")

[sub_resource type="BTSequence" id="BTSequence_idle"]
custom_name = "Seq - Idle"
children = [SubResource("BTAction_idle")]

[sub_resource type="BTSelector" id="BTSelector_root"]
children = [SubResource("BTSequence_defend"), SubResource("BTSequence_deliver"), SubResource("BTSequence_gather"), SubResource("BTSequence_idle")]

[resource]
blackboard_plan = SubResource("BlackboardPlan_wasp")
root_task = SubResource("BTSelector_root")
