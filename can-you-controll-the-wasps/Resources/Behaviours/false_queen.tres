[gd_resource type="Resource" script_class="BehaviourProfile" format=3]

[ext_resource type="Script" path="res://Scripts/Mechanics/behaviour_profile.gd" id="1_behaviour"]

; 伪王后的画像。**每一条区间都是 worker.tres 对应区间的真子集，而且不贴边。**
;
; "不贴边" 是踩坑踩出来的：区间只要理论上重叠是不够的。场上只有十几只工蜂，
; 她们抽出来的样本填不满理论区间——worker 的 antennate 写着 0.7..1.5，实际十一只
; 抽出来是 0.99..1.35。她要是抽到 0.84，理论上合法，玩家看到的却是一个
; 谁都没有的数。所以她的区间要落在工蜂的**高概率区**，两头各留一成余量。
;
; Overlapping on paper is not enough: with a dozen workers the observed spread is much
; narrower than the declared range, so her band must sit inside their LIKELY range,
; not merely inside their declared one. Leave ~10% headroom at both ends.
;
; 她偏的三处，全是她真实意图漏出来的，不是演的：
;   inspect  偏高 —— 她要找空巢室下蛋，所以在格子上方晃得更勤
;   antennate 偏低 —— 她回避社交
;   posting_bias 偏低 —— 她有自己的事要办，更容易脱岗
; 她**不改颜色，也不改外观**。破绽只准出在行为上。
;
; 改完拿 F11 那行 overlap 读数验：打了 ! 的那一条就是已经变成探测器的。

[resource]
script = ExtResource("1_behaviour")
display_name = "False Queen"
sight_radius = Vector2(295, 372)
loiter_radius = Vector2(162, 228)
loiter_speed = Vector2(47, 62)
inspect_weight = Vector2(0.95, 1.22)
attend_weight = Vector2(0.75, 1.15)
antennate_weight = Vector2(0.88, 1.15)
patrol_weight = Vector2(0.55, 1.05)
groom_weight = Vector2(0.65, 1.1)
linger_time = Vector2(1.9, 3.0)
urge_interval = Vector2(2.4, 5)
cardboard_threshold = Vector2(0.32, 0.52)
; 工蜂的喂食区间从 0.20~0.52 拉低到 0.14~0.46 之后，原来的 0.30~0.49 上端伸出去了：
; 0.46~0.49 那一段变成只有她抽得到的值，那就是探测器不是线索
; The worker band moved down, and the old upper end poked out of it - queen-only values.
food_threshold = Vector2(0.22, 0.4)
posting_bias = Vector2(0.12, 0.22)
reconsider_interval = Vector2(3.4, 6)
